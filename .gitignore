# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
.env.vercel
.env.vercel.*

# Google service account keys (never commit)
/secrets/
*service-account*.json
*-credentials.json

# import dry-run output
/tmp

# local practice store (attempts / users / learn stay local)
/data/attempts/
/data/users.json
/data/keys/
/data/learn/*
!/data/learn/.gitkeep
# published demo tests for Vercel (file-backed catalog)
/data/tests/*
!/data/tests/test-1-*.json
!/data/tests/test-9-*.json

# uploaded audio (keep folder + Test 1/9 listening for production)
/public/uploads/audio/*
!/public/uploads/audio/.gitkeep
!/public/uploads/audio/test-1-section-*.mp3
!/public/uploads/audio/test-9-section-*.mp3

# learn lesson videos (keep folder)
/public/uploads/learn/videos/*
!/public/uploads/learn/videos/.gitkeep

# user avatars (keep folder)
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel
