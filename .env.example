# Neon Postgres — lấy connection string từ https://console.neon.tech
# Dùng pooled URL (?sslmode=require) cho Vercel / serverless
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Session cookie signing (đổi giá trị dài ≥16 ký tự trên production)
SESSION_SECRET="change-me-to-a-long-random-string"

# Dev only: mở /admin khi CHƯA đăng nhập (guest). KHÔNG cấp quyền admin cho STUDENT đã login.
# Production / Vercel public: PHẢI để false (hoặc xóa dòng này).
ALLOW_OPEN_ADMIN="false"

# (Tuỳ chọn) thư mục data khi deploy — Vercel mặc định /tmp/wewin-data
# DATA_DIR="/tmp/wewin-data"

# Seed admin (scripts/seed-admin.ts)
# ADMIN_EMAIL="admin@wewin.local"
# ADMIN_PASSWORD="change-me"
# ADMIN_USERNAME="admin"

# --- Google Drive sync (admin /admin/import) ---
GOOGLE_SERVICE_ACCOUNT_JSON="./secrets/google-service-account.json"
GOOGLE_DRIVE_FOLDER_ID=""

# --- OpenAI (Speaking / Writing AI scoring) ---
# Keep real keys in .env / .env.local only (gitignored). Never commit secrets.
OPENAI_API_KEY=""
OPENAI_WHISPER_MODEL="whisper-1"
OPENAI_AUDIO_MODEL="gpt-audio-1.5"
OPENAI_SCORE_MODEL="gpt-4o-mini"
# Optional realtime voice (future)
# OPENAI_REALTIME_MODEL="gpt-realtime-2.1-mini"

# --- Cloudflare R2 (Listening audio + writing/images CDN) ---
# Local `npm run dev` works without these (serves public/uploads/...).
# Production / Vercel: set all of these so media is not shipped in the deploy.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="wewin-ielts-media"
# Public URL for browsers (<audio>/<img>). Prefer a custom domain:
#   R2_PUBLIC_BASE_URL="https://media.your-domain.com"
# Or R2.dev public URL after enabling public access on the bucket:
#   R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"
# Upload local files once: npm run media:upload-r2
# See docs/DEPLOY_VERCEL.md → Cloudflare R2.

# --- Zoom Classroom prototype ---
# Meeting SDK app credentials (server-side only; never use NEXT_PUBLIC_).
ZOOM_MEETING_SDK_KEY=""
ZOOM_MEETING_SDK_SECRET=""

# Required only when the teacher starts the meeting inside WEWIN.
# Create a Server-to-Server OAuth app in the same Zoom account.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_HOST_USER_ID=""

# Encrypt meeting passcodes stored in Postgres (long random value, >= 16 chars).
CLASSROOM_SECRET_ENCRYPTION_KEY=""

# Ably Free API key. Browser clients receive subscribe-only token requests.
ABLY_API_KEY=""

# One-time prototype seed (`npm run seed:classroom`).
# CLASSROOM_CODE="WW00016"
# CLASSROOM_NAME="IELTS WW00016"
# CLASSROOM_TEACHER_USERNAME="teacher"
# CLASSROOM_SESSION_TITLE="IELTS live class"
# CLASSROOM_SESSION_START="2026-10-23T19:00:00+07:00"
# CLASSROOM_SESSION_END="2026-10-23T20:30:00+07:00"
# ZOOM_PROTOTYPE_MEETING_ID=""
# ZOOM_PROTOTYPE_MEETING_PASSCODE=""
# CLASSROOM_SLIDES_JSON='[{"id":"slide-1","imageUrl":"https://media.example.com/slide-1.webp","alt":"Slide 1"}]'
