# Neon Postgres — lấy connection string từ https://console.neon.tech
# Dùng pooled URL (?sslmode=require) cho Vercel / serverless
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Session cookie signing (đổi giá trị dài ≥16 ký tự trên production)
SESSION_SECRET="change-me-to-a-long-random-string"

# Shared SSO across *.wewin.edu.vn (production). Leave unset for localhost host-only cookies.
# Must match SESSION_SECRET on Cambridge + AdminPanel (admin.wewin.edu.vn).
# On login, host-only wewin_session is cleared and re-issued with this Domain (dual-write migrate).
# SESSION_COOKIE_DOMAIN=".wewin.edu.vn"
# Comma-separated origins (exact) or parent suffixes (".wewin.edu.vn") for post-login returnTo.
# WEWIN_HUB_ALLOWED_RETURN_ORIGINS="https://admin.wewin.edu.vn,https://exam.wewin.edu.vn,.wewin.edu.vn"
# Default campus label on hub placement rows when User has no campus field
# WEWIN_SITE_BRANCH="NTL"
# Public IELTS origin (required on Vercel so links never use *.vercel.app)
# NEXT_PUBLIC_SITE_URL="https://ielts.wewin.edu.vn"
# Unified Admin Panel (/admin/hub) — SAME value as Cambridge WEWIN_HUB_API_KEY (≥16 chars)
# WEWIN_HUB_API_KEY="change-me-long-random-hub-key"
# CAMBRIDGE_HUB_URL="https://cambridge-placement-test.vercel.app/api/hub/placement-attempts"
# Optional: Cambridge browser origin for SSO redirect (defaults to origin of CAMBRIDGE_HUB_URL)
# CAMBRIDGE_PUBLIC_SITE_URL="https://cambridge-placement-test.vercel.app"

# Dev only: mở /admin khi CHƯA đăng nhập (guest). KHÔNG cấp quyền admin cho STUDENT đã login.
# Production / Vercel public: PHẢI để false (hoặc xóa dòng này).
ALLOW_OPEN_ADMIN="false"

# (Tuỳ chọn) thư mục data khi deploy — Vercel mặc định /tmp/wewin-data
# DATA_DIR="/tmp/wewin-data"

# Seed admin (scripts/seed-admin.ts)
# ADMIN_EMAIL="admin@wewin.local"
# ADMIN_PASSWORD="change-me"
# ADMIN_USERNAME="admin"

# --- Google Drive sync (admin /admin/import) ---
GOOGLE_SERVICE_ACCOUNT_JSON="./secrets/google-service-account.json"
GOOGLE_DRIVE_FOLDER_ID=""

# --- OpenAI (Speaking / Writing AI scoring) ---
# Keep real keys in .env / .env.local only (gitignored). Never commit secrets.
OPENAI_API_KEY=""
OPENAI_WHISPER_MODEL="whisper-1"
OPENAI_AUDIO_MODEL="gpt-audio-1.5"
OPENAI_SCORE_MODEL="gpt-4o-mini"
# Optional realtime voice (future)
# OPENAI_REALTIME_MODEL="gpt-realtime-2.1-mini"

# --- Cloudflare R2 (Listening audio + writing/images CDN) ---
# Local `npm run dev` works without these (serves public/uploads/...).
# Production / Vercel: set all of these so media is not shipped in the deploy.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="wewin-ielts-media"
# Public URL for browsers (<audio>/<img>). Prefer a custom domain:
#   R2_PUBLIC_BASE_URL="https://media.your-domain.com"
# Or R2.dev public URL after enabling public access on the bucket:
#   R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"
# Upload local files once: npm run media:upload-r2
# See docs/DEPLOY_VERCEL.md → Cloudflare R2.

# --- Zoom Classroom prototype ---
# Meeting SDK app credentials (server-side only; never use NEXT_PUBLIC_).
ZOOM_MEETING_SDK_KEY=""
ZOOM_MEETING_SDK_SECRET=""

# Required only when the teacher starts the meeting inside WEWIN.
# Create a Server-to-Server OAuth app in the same Zoom account.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_HOST_USER_ID=""

# Encrypt meeting passcodes stored in Postgres (long random value, >= 16 chars).
CLASSROOM_SECRET_ENCRYPTION_KEY=""

# Ably Free API key. Browser clients receive subscribe-only token requests.
ABLY_API_KEY=""

# One-time prototype seed (`npm run seed:classroom`).
# CLASSROOM_CODE="WW00016"
# CLASSROOM_NAME="IELTS WW00016"
# CLASSROOM_TEACHER_USERNAME="teacher"
# CLASSROOM_SESSION_TITLE="IELTS live class"
# CLASSROOM_SESSION_START="2026-10-23T19:00:00+07:00"
# CLASSROOM_SESSION_END="2026-10-23T20:30:00+07:00"
# ZOOM_PROTOTYPE_MEETING_ID=""
# ZOOM_PROTOTYPE_MEETING_PASSCODE=""
# CLASSROOM_SLIDES_JSON='[{"id":"slide-1","imageUrl":"https://media.example.com/slide-1.webp","alt":"Slide 1"}]'


# --- Fastbots Chat History (/admin/hub → Chat History) ---
# Webhook secret (≥16 chars). Fastbots Contact Settings → Endpoint URL:
#   https://ielts.wewin.edu.vn/api/webhooks/fastbots?secret=<FASTBOTS_WEBHOOK_SECRET>
# (Fastbots UI has no custom header field; query secret is supported.)
# Also accepted: Authorization: Bearer … or X-Fastbots-Secret
# FASTBOTS_WEBHOOK_SECRET=""
# Optional dashboard link shown in admin UI
# FASTBOTS_DASHBOARD_URL="https://app.fastbots.ai/"
# Bot API key (Settings → API). Used by /api/chat/fastbots for the site widget
# (each message uses Fastbots credits). Also syncs turns to /admin/hub Chat History.
# FASTBOTS_API_KEY=""

# --- Facebook Messenger / Fanpage → /admin/hub Chat History ---
# Page ID + long-lived Page Access Token (Graph API).
# Used by «Đồng bộ Messenger» and «Đồng bộ Comment».
# Comment sync needs pages_read_engagement + pages_read_user_content on the token.
# FACEBOOK_PAGE_ID=""
# FACEBOOK_PAGE_ACCESS_TOKEN=""
# Optional live webhook: https://ielts.wewin.edu.vn/api/webhooks/messenger
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=""
# FACEBOOK_APP_SECRET=""

# --- Google Analytics 4 (GA4) ---
# Dùng chung Measurement ID cho hệ thống multi-subdomain WeWIN
NEXT_PUBLIC_GA_ID="G-BHPHF3EMKF"
