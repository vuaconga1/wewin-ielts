// IELTS practice — core schema for import + practice
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  /// Registered learner without a class ("Khách"); differs from a signed-out guest.
  VISITOR
  TEACHER
  ADMIN
}

enum AccessPlan {
  FREE
  PAID
  UNLIMITED
}

enum Skill {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum ExamType {
  ACADEMIC
  GENERAL
  PLACEMENT
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  GAP_FILL
  MULTIPLE_CHOICE
  TRUE_FALSE_NG
  MATCHING
  SHORT_ANSWER
  TABLE_COMPLETION
  MAP_LABELING
  ESSAY
  SPEAKING_PROMPT
}

enum AttemptMode {
  PRACTICE
  FULL
}

enum MediaType {
  AUDIO
  IMAGE
  OTHER
}

enum ImportJobStatus {
  PENDING
  PARSING
  VALIDATED
  FAILED
  PERSISTED
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

enum ClassTeacherRole {
  HOST
  CO_HOST
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum PresentationMode {
  NONE
  WEWIN_SLIDES
  ZOOM_SCREEN_SHARE
}

model User {
  id              String     @id @default(cuid())
  /// Optional — accounts can sign in with username + password only
  email           String?    @unique
  username        String     @unique
  passwordHash    String
  role            Role       @default(STUDENT)
  /// Display name (Họ tên)
  fullName        String?
  /// Class code(s), e.g. WW00016 or "WW00019, WW00020"
  classCode       String?
  /// Profile image: /avatars/default-*.svg, /uploads/avatars/*, or data URL
  avatarUrl       String?
  accessPlan      AccessPlan @default(FREE)
  accessStartsAt  DateTime   @default(now())
  accessExpiresAt DateTime?
  /// Staff only: Zoom user (inside a configured ZoomAccount) that hosts this teacher's new sessions
  zoomAccountId   String?
  zoomUserId      String?
  zoomUserEmail   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  zoomAccount       ZoomAccount?        @relation("UserZoomHost", fields: [zoomAccountId], references: [id], onDelete: SetNull)
  attempts          Attempt[]
  importJobs        ImportJob[]
  auditLogs         AuditLog[]
  dictationAttempts DictationAttempt[]
  shadowingAttempts ShadowingAttempt[]
  classEnrollments  ClassEnrollment[]
  classAssignments  ClassTeacher[]
  hostedSessions    LiveSession[]       @relation("LiveSessionHost")
  presentations     Presentation[]      @relation("PresentationCreator")
  presentationEdits PresentationState[] @relation("PresentationUpdater")
  homeworkCreated   ClassAssignment[]   @relation("ClassAssignmentCreator")

  @@index([classCode])
  @@index([accessPlan, accessExpiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  username  String
  fullName  String?
  role      Role
  action    String
  ipAddress String?
  userAgent String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([role, createdAt])
  @@index([action, createdAt])
}

/// One row per browser visit (deduped per visitor within 30 minutes).
model SiteVisit {
  id        String   @id @default(cuid())
  /// Anonymous per-browser id from localStorage
  visitorId String
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
}

/// Zoom Server-to-Server OAuth + Meeting SDK credentials managed from /admin/zoom.
/// Secrets are AES-GCM encrypted with CLASSROOM_SECRET_ENCRYPTION_KEY.
model ZoomAccount {
  id                     String    @id @default(cuid())
  name                   String
  accountId              String
  clientId               String
  clientSecretCiphertext String    @db.Text
  sdkKey                 String
  sdkSecretCiphertext    String    @db.Text
  /// Zoom user (id or email) that owns created meetings; "me" = account owner
  hostUserId             String    @default("me")
  isDefault              Boolean   @default(false)
  lastVerifiedAt         DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  classrooms   Classroom[]
  liveSessions LiveSession[]
  linkedUsers  User[]        @relation("UserZoomHost")

  @@index([isDefault])
}

model Classroom {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  timezone      String          @default("Asia/Ho_Chi_Minh")
  status        ClassroomStatus @default(ACTIVE)
  zoomAccountId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  zoomAccount   ZoomAccount?      @relation(fields: [zoomAccountId], references: [id], onDelete: SetNull)
  enrollments   ClassEnrollment[]
  teachers      ClassTeacher[]
  liveSessions  LiveSession[]
  presentations Presentation[]
  assignments   ClassAssignment[]

  @@index([status, code])
}

/// Homework: one IELTS test (whole paper or selected parts) assigned to a class with a deadline.
/// Labels are snapshotted so the list stays readable if the test is renamed.
model ClassAssignment {
  id            String   @id @default(cuid())
  classroomId   String
  testId        String
  /// Parts (TestSection.order) the learner must submit; always explicit, full list = whole test
  sectionOrders Int[]
  wholeTest     Boolean  @default(true)
  testSlug      String
  testTitle     String
  skill         Skill
  /// e.g. "Part 1, Part 3"; null when wholeTest
  partLabel     String?
  questionCount Int      @default(0)
  deadlineAt    DateTime
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  test      Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ClassAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([classroomId, deadlineAt])
  @@index([testId])
}

model ClassEnrollment {
  id          String           @id @default(cuid())
  classroomId String
  userId      String
  status      EnrollmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([userId, status])
}

model ClassTeacher {
  id          String           @id @default(cuid())
  classroomId String
  userId      String
  role        ClassTeacherRole @default(HOST)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([userId, role])
}

model LiveSession {
  id                     String            @id @default(cuid())
  classroomId            String
  hostUserId             String?
  title                  String
  scheduledStart         DateTime
  scheduledEnd           DateTime?
  status                 LiveSessionStatus @default(SCHEDULED)
  zoomMeetingId          String
  zoomHostUserId         String?
  zoomPasscodeCiphertext String?           @db.Text
  /// Set when WEWIN created the meeting through this account (null = manual/legacy env meeting)
  zoomAccountId          String?
  /// Occurrence of a Zoom recurring meeting (weekly series)
  zoomOccurrenceId       String?
  /// Shared by every session created from one weekly schedule
  seriesId               String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  classroom         Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  host              User?              @relation("LiveSessionHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  zoomAccount       ZoomAccount?       @relation(fields: [zoomAccountId], references: [id], onDelete: Restrict)
  presentationState PresentationState?

  @@index([classroomId, scheduledStart])
  @@index([hostUserId, scheduledStart])
  @@index([zoomMeetingId])
  @@index([zoomAccountId])
  @@index([seriesId])
}

model Presentation {
  id          String   @id @default(cuid())
  classroomId String
  createdById String?
  title       String
  /// [{ "id": "slide-1", "imageUrl": "https://...", "alt": "..." }]
  slides      Json
  slideCount  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classroom Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy User?               @relation("PresentationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  states    PresentationState[]

  @@index([classroomId, createdAt])
}

model PresentationState {
  id             String           @id @default(cuid())
  liveSessionId  String           @unique
  presentationId String?
  slideIndex     Int              @default(0)
  version        Int              @default(0)
  mode           PresentationMode @default(NONE)
  updatedById    String?
  updatedAt      DateTime         @updatedAt

  liveSession  LiveSession   @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  presentation Presentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("PresentationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([presentationId])
  @@index([updatedById, updatedAt])
}

model RateLimitBucket {
  id          String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model Test {
  id               String     @id @default(cuid())
  title            String
  slug             String     @unique
  skill            Skill
  examType         ExamType   @default(ACADEMIC)
  timeLimitMinutes Int?
  tags             Json?
  status           TestStatus @default(DRAFT)
  practiceCount    Int        @default(0)
  sourceFolder     String?
  description      String?    @db.Text
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sections TestSection[]
  media    MediaAsset[]
  attempts Attempt[]
  imports  ImportJob[]
  homework ClassAssignment[]
}

model TestSection {
  id            String  @id @default(cuid())
  testId        String
  title         String
  order         Int
  questionCount Int     @default(0)
  /// Optional instructions / passage text for this part
  content       String? @db.Text
  /// e.g. { "audioStart": "00:00", "audioEnd": "05:30" }
  meta          Json?

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([testId, order])
  @@index([testId])
}

model Question {
  id        String       @id @default(cuid())
  sectionId String
  order     Int
  /// Display number as in source, e.g. 1, 2, 14
  number    Int
  type      QuestionType
  /// Stem, options, table cells, etc.
  content   Json
  mediaUrl  String?

  section        TestSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answerKey      AnswerKey?
  attemptAnswers AttemptAnswer[]

  @@unique([sectionId, order])
  @@index([sectionId])
}

model AnswerKey {
  id                String  @id @default(cuid())
  questionId        String  @unique
  /// Canonical answer(s): string | string[] | object
  correctAnswer     Json
  /// Extra accepted variants after normalize
  acceptableAnswers Json?
  explanation       String? @db.Text

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Attempt {
  id               String      @id @default(cuid())
  userId           String?
  testId           String
  mode             AttemptMode
  /// Selected section ids for practice mode
  sectionIds       Json?
  timeLimitMinutes Int?
  startedAt        DateTime    @default(now())
  finishedAt       DateTime?
  scoreRaw         Int?
  scoreBand        Float?
  /// Full practice attempt JSON (StoredAttempt) — durable across serverless instances
  payload          Json?

  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  test    Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@index([testId])
  @@index([userId])
  @@index([startedAt])
  @@index([userId, startedAt])
}

model AttemptAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  userAnswer Json?
  isCorrect  Boolean?

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model MediaAsset {
  id       String    @id @default(cuid())
  testId   String
  type     MediaType
  path     String
  duration Int?
  label    String?

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

model ImportJob {
  id          String          @id @default(cuid())
  adminId     String?
  testId      String?
  status      ImportJobStatus @default(PENDING)
  sourceFiles Json?
  /// Structured parse result before persist
  payload     Json?
  errors      Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  test  Test? @relation(fields: [testId], references: [id], onDelete: SetNull)

  @@index([status])
}

enum DictationAttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum DictationMode {
  /// Learner types the whole transcript
  FULL_TEXT
  /// Learner fills teacher-selected gaps in the transcript
  FILL_BLANK
  /// Learner answers short questions about the audio (rule-based keyword grading)
  QUESTION_ANSWER
}

/// Short audio + transcript; transcript never leaves the server before submit.
model DictationExercise {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  /// CEFR level, e.g. A2, B1
  level        String?
  instructions String?       @db.Text
  audioUrl     String
  transcript   String        @db.Text
  mode         DictationMode @default(FULL_TEXT)
  /// FILL_BLANK only: FillBlankGap[] — { id, startToken, endToken (exclusive), acceptedAnswers? }
  gaps         Json?
  /// QUESTION_ANSWER only: ListenQuestion[] — { id, prompt, answers, match, rejectAnswers?, maxWords? }
  questions    Json?
  /// { maxListenCount: number | null, playbackRates: number[], scoringMode: "LEARNING" }
  settings     Json?
  status       TestStatus    @default(PUBLISHED)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  attempts DictationAttempt[]

  @@index([status, order])
}

model DictationAttempt {
  id               String                 @id @default(cuid())
  userId           String?
  exerciseId       String
  status           DictationAttemptStatus @default(IN_PROGRESS)
  submittedText    String?                @db.Text
  normalizedText   String?                @db.Text
  score            Int?
  correctCount     Int?
  totalWords       Int?
  listenCount      Int                    @default(0)
  startedAt        DateTime               @default(now())
  completedAt      DateTime?
  durationSeconds  Int?
  /// DictationWordResult[] — correct | missing | extra | incorrect
  wordResults      Json?
  errorSummary     Json?
  /// FILL_BLANK / QUESTION_ANSWER: { [gapId | questionId]: string }
  submittedAnswers Json?
  /// FILL_BLANK only: FillBlankGapResult[] graded at submit time
  gapResults       Json?
  /// QUESTION_ANSWER only: ListenQuestionResult[] graded at submit time
  questionResults  Json?

  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  exercise DictationExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([exerciseId])
  @@index([userId, exerciseId, startedAt])
}

model ShadowingExercise {
  id               String     @id @default(cuid())
  slug             String     @unique
  title            String
  level            String?
  instructions     String?    @db.Text
  audioUrl         String
  transcript       String     @db.Text
  maxRecordSeconds Int        @default(30)
  status           TestStatus @default(PUBLISHED)
  order            Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  attempts ShadowingAttempt[]

  @@index([status, order])
}

model ShadowingAttempt {
  id                 String    @id @default(cuid())
  userId             String
  exerciseId         String
  /// STT backend that produced recognizedText, e.g. "web-speech" (test only)
  sttProvider        String
  recognizedText     String    @db.Text
  normalizedText     String    @db.Text
  /// Content match score 0–100 = max(0, 100 × (1 − WER)); not a pronunciation score
  score              Int
  wer                Float
  totalWords         Int
  correctCount       Int
  substitutionCount  Int
  deletionCount      Int
  insertionCount     Int
  wordResults        Json
  errorSummary       Json
  /// Private storage key; nulled once the recording is purged
  recordingKey       String?
  recordingMime      String?
  recordingMs        Int?
  recordingExpiresAt DateTime?
  createdAt          DateTime  @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise ShadowingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId, createdAt])
  @@index([exerciseId, createdAt])
  @@index([recordingExpiresAt])
}
