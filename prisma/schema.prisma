// IELTS practice — core schema for import + practice
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum Skill {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum ExamType {
  ACADEMIC
  GENERAL
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  GAP_FILL
  MULTIPLE_CHOICE
  TRUE_FALSE_NG
  MATCHING
  SHORT_ANSWER
  TABLE_COMPLETION
  MAP_LABELING
  ESSAY
  SPEAKING_PROMPT
}

enum AttemptMode {
  PRACTICE
  FULL
}

enum MediaType {
  AUDIO
  IMAGE
  OTHER
}

enum ImportJobStatus {
  PENDING
  PARSING
  VALIDATED
  FAILED
  PERSISTED
}

model User {
  id           String   @id @default(cuid())
  /// Optional — accounts can sign in with username + password only
  email        String?  @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  /// Display name (Họ tên)
  fullName     String?
  /// Class code(s), e.g. WW00016 or "WW00019, WW00020"
  classCode    String?
  /// Profile image: /avatars/default-*.svg, /uploads/avatars/*, or data URL
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attempts   Attempt[]
  importJobs ImportJob[]

  @@index([classCode])
}

model Test {
  id                String     @id @default(cuid())
  title             String
  slug              String     @unique
  skill             Skill
  examType          ExamType   @default(ACADEMIC)
  timeLimitMinutes  Int?
  tags              Json?
  status            TestStatus @default(DRAFT)
  practiceCount     Int        @default(0)
  sourceFolder      String?
  description       String?    @db.Text
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sections TestSection[]
  media    MediaAsset[]
  attempts Attempt[]
  imports  ImportJob[]
}

model TestSection {
  id            String @id @default(cuid())
  testId        String
  title         String
  order         Int
  questionCount Int    @default(0)
  /// Optional instructions / passage text for this part
  content       String? @db.Text
  /// e.g. { "audioStart": "00:00", "audioEnd": "05:30" }
  meta          Json?

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([testId, order])
  @@index([testId])
}

model Question {
  id        String       @id @default(cuid())
  sectionId String
  order     Int
  /// Display number as in source, e.g. 1, 2, 14
  number    Int
  type      QuestionType
  /// Stem, options, table cells, etc.
  content   Json
  mediaUrl  String?

  section       TestSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answerKey     AnswerKey?
  attemptAnswers AttemptAnswer[]

  @@unique([sectionId, order])
  @@index([sectionId])
}

model AnswerKey {
  id               String  @id @default(cuid())
  questionId       String  @unique
  /// Canonical answer(s): string | string[] | object
  correctAnswer    Json
  /// Extra accepted variants after normalize
  acceptableAnswers Json?
  explanation      String? @db.Text

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Attempt {
  id              String      @id @default(cuid())
  userId          String?
  testId          String
  mode            AttemptMode
  /// Selected section ids for practice mode
  sectionIds      Json?
  timeLimitMinutes Int?
  startedAt       DateTime    @default(now())
  finishedAt      DateTime?
  scoreRaw        Int?
  scoreBand       Float?
  /// Full practice attempt JSON (StoredAttempt) — durable across serverless instances
  payload         Json?

  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  test    Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@index([testId])
  @@index([userId])
  @@index([startedAt])
  @@index([userId, startedAt])
}

model AttemptAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  userAnswer Json?
  isCorrect  Boolean?

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model MediaAsset {
  id       String    @id @default(cuid())
  testId   String
  type     MediaType
  path     String
  duration Int?
  label    String?

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

model ImportJob {
  id          String          @id @default(cuid())
  adminId     String?
  testId      String?
  status      ImportJobStatus @default(PENDING)
  sourceFiles Json?
  /// Structured parse result before persist
  payload     Json?
  errors      Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  test  Test? @relation(fields: [testId], references: [id], onDelete: SetNull)

  @@index([status])
}
